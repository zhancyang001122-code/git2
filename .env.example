VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
VITE_INTERNAL_ACCOUNT_EMAIL=internal-account-1@archflow.local

# 访客模式的非敏感模型默认值（可选）。
VITE_LLM_BASE_URL=https://api.openai.com/v1
VITE_LLM_MODEL=gpt-5-mini
VITE_IMAGE_BASE_URL=https://api.openai.com/v1
VITE_IMAGE_MODEL=gpt-image-2
VITE_IMAGE_SIZE=1536x1024

# 语言模型和生图模型 Key 不应写在 Vite 环境变量中。
# 它们必须配置为 Supabase Edge Function Secrets，参见 supabase/README.md。
